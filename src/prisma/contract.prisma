// use prisma-8
// Printed from prisma/schema.prisma by `prisma contract print`.

namespace public {
  model Post {
    id        String       @id @default(cuid(2))
    ownerId   String
    title     String       @default("")
    content   String
    published Timestamp(3) @default(now())
    updatedAt Timestamp(3) @default(now())
    comments  Comment[]
    postlike  PostLike[]

    @@index([ownerId, published], map: "Post_ownerId_published_idx")
  }

  model Comment {
    id        String       @id @default(uuid())
    postId    String
    ownerId   String
    content   String       @default("")
    createdAt Timestamp(3) @default(now())
    updatedAt Timestamp(3) @default(now())
    post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@index([ownerId, createdAt], map: "Comment_ownerId_createdAt_idx")
  }

  model PostLike {
    id        String       @id @default(uuid())
    postId    String
    ownerId   String
    createdAt Timestamp(3) @default(now())
    post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@index([ownerId, createdAt], map: "PostLike_ownerId_createdAt_idx")
  }
}
